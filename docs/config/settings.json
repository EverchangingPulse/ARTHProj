{
  "version": 1,
  "camera": {
    "autoStart": true
  },
  "tracking": {
    "maxTrack": 1
  },
  "overlay": {
    "opacity": 1
  },
  "scanner": {
    "enabled": true,
    "style": "astrolabe"
  },
  "capture": {
    "autoFreeze": true,
    "freezeDelayMs": 700,
    "shutterSound": true
  },
  "compass": {
    "enabled": true,
    "preferTrueNorth": true,
    "requestLocation": true,
    "headingSmoothing": 0.21
  },
  "display": {
    "fullscreen": true
  }
}
